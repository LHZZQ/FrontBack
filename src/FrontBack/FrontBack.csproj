<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../local.props" Condition="Exists('../../local.props')" />
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FrontBack</AssemblyName>
    <Version>0.3.0</Version>
    <GameDir Condition="'$(GameDir)' == ''">D:\steam\steamapps\common\Slay the Spire 2</GameDir>
    <GameDataDir>$(GameDir)/data_sts2_windows_x86_64</GameDataDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2"><HintPath>$(GameDataDir)/sts2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(GameDataDir)/GodotSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameDataDir)/0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckGameFiles" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameDataDir)/sts2.dll')" Text="找不到 sts2.dll，请在 local.props 设置 GameDir。" />
  </Target>
</Project>
